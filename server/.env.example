# Copy to .env and fill in. .env is in .gitignore and never committed.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Any long random string, e.g. from: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where the browser opens the site. In dev that's the Vite server.
BETTER_AUTH_URL=http://localhost:5173
# Stripe test mode: the secret key (sk_test_...) from the Stripe dashboard
STRIPE_SECRET_KEY=
# The webhook signing secret (whsec_...). Locally, the one printed by
# stripe listen --forward-to localhost:3000/api/webhooks/stripe
# In production, the one from the dashboard's webhook endpoint.
STRIPE_WEBHOOK_SECRET_KEY=

# Optional: the port Express listens on (3000 if unset). If you change it,
# set BACKEND_PROXY_PORT in client/.env to the same number.
PORT=3210

# Email (receipts, refunds, password reset) over SMTP. Mailtrap's sandbox
# catches the emails in an inbox on mailtrap.io instead of delivering them:
# Email Testing -> your inbox -> SMTP settings. Without these four the
# server still runs, and only logs the emails it would have sent.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional: true for a provider that wants TLS from the first byte (port
# 465 elsewhere). Mailtrap switches to TLS later (STARTTLS), so leave it out.
SMTP_SECURE=
